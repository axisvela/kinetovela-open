{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KINETOVELA EffectRecord v1",
  "type": "object",
  "required": ["schema_version", "effect_record_id", "command_ref", "status", "evidence_refs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "effect_record_id": { "type": "string", "minLength": 1 },
    "command_ref": { "type": "string", "minLength": 1 },
    "status": { "enum": ["observed", "reported", "failed", "unknown_effect"] },
    "observed_effect": { "type": "string" },
    "state_delta_ref": { "type": "string" },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
