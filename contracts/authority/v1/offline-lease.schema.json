{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KINETOVELA OfflineLease v1",
  "type": "object",
  "required": ["schema_version", "lease_id", "authority_ref", "robot_ref", "expires_at", "max_missions", "allowed_effects"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "lease_id": { "type": "string", "minLength": 1 },
    "authority_ref": { "type": "string", "minLength": 1 },
    "robot_ref": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date-time" },
    "max_missions": { "type": "integer", "minimum": 1 },
    "allowed_effects": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
